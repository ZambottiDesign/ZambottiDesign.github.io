   <dc:subject>
    <rdf:Bag>
     <rdf:li>Baro, police dog</rdf:li>
    </rdf:Bag>
   </dc:subject>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Baro, the police department&amp;rsquo;s German shepherd, takes a rest at a May event at which police demonstrated the dog&amp;rsquo;s law enforcement skills. Baro died this week.</rdf:li>
    </rdf:Alt>
   </dc:description>
